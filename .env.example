# CausalAgentBench environment variables (copy to .env — never commit .env)
# Keys are read from the environment only; YAML configs must not contain secrets.

# --- Optional commercial API providers (paid) ---
# OPENAI_API_KEY=
# OPENAI_MODEL_ID=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_ID=claude-3-5-sonnet-latest
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL_ID=gemini-2.0-flash
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL_ID=openai/gpt-4o-mini

# --- OpenAI-compatible remote endpoint ---
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://your-endpoint.example/v1
# OPENAI_COMPATIBLE_MODEL_ID=your-model-id

# --- Local open-weight server (no paid API; see docs/OPEN_WEIGHT_LOCAL_MODELS.md) ---
# LOCAL_OPENAI_BASE_URL=http://localhost:11434/v1
# LOCAL_OPENAI_MODEL_ID=your-ollama-or-vllm-model-tag
# LOCAL_OPENAI_API_KEY=

# --- Zero-cost free-tier routes (no monetary spend; preliminary evidence only) ---
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL_ID=google/gemma-2-9b-it:free
# GEMINI_API_KEY=
# GEMINI_MODEL_ID=gemini-2.0-flash

# --- Runtime (optional) ---
# PYTHON=python3
# MPLCONFIGDIR=/tmp/matplotlib
