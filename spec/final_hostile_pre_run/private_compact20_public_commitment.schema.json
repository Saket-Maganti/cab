{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_content_hashes": {"additionalProperties": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "type": "object"},
    "candidate_count": {"const": 20},
    "commitment_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "difficulty_counts": {"type": "object"},
    "domain_counts": {"type": "object"},
    "exposure_scan_result": {"const": "PASS_NO_PUBLIC_MATCH"},
    "family_counts": {"type": "object"},
    "generator_version": {"type": "string"},
    "packet_id": {"type": "string"},
    "private_bodies_committed": {"const": false},
    "schema_version": {"const": "cab_private_compact20_public_commitment_v1"},
    "seed_commitment": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "stage1_package_hashes": {"additionalProperties": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "type": "object"},
    "stage2_encrypted_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "stage2_private_and_unexposed": {"const": true},
    "status": {"const": "CAB_NEW_COMPACT20_PRIVATE_SLICE_READY"}
  },
  "required": [
    "schema_version",
    "status",
    "packet_id",
    "candidate_count",
    "family_counts",
    "domain_counts",
    "difficulty_counts",
    "candidate_content_hashes",
    "stage1_package_hashes",
    "stage2_encrypted_sha256",
    "generator_version",
    "seed_commitment",
    "exposure_scan_result",
    "private_bodies_committed",
    "stage2_private_and_unexposed",
    "commitment_sha256"
  ],
  "type": "object"
}
